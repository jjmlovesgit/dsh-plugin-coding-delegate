# Copy to .env (or export these) before running. Nothing here is required for the
# plugin to load; a missing key only matters when the provider that uses it is called.

# Provider API keys. LM STUDIO API KEY may be any non-empty value if your local
# server does not check it; DEEPSEEK_API_KEY is needed only for a DeepSeek provider.
LM_STUDIO_API_KEY=none
DEEPSEEK_API_KEY=

# Read by the plugin: prompt size above which routing goes straight to cloud.
CONTEXT_TOKEN_THRESHOLD=30000

# Also read: DSH_HOME, DSH_LOCAL_ROUTER_DATA_DIR (state location) and
# DSH_LOCAL_ROUTER_RAW_VERIFICATION=1 (return unredacted verification output).
