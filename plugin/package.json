{
  "name": "dsh-plugin-coding-delegate",
  "version": "0.2.0",
  "description": "Your plan is for thinking, your GPU does the typing: a DeepSeek Harness plugin that keeps code out of the metered context, so credentials stay local, the cloud model cannot write or read back source, and code work is delegated and returns a verdict",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "cordis.patch.yml",
    "cordis.patch.example.yml"
  ],
  "cordis": {
    "name": "dsh-plugin-coding-delegate"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:oracles": "node --require ./scripts/isolate-oracle-data-dir.cjs --test tests/oracles/*.test.cjs",
    "test:all": "npm run test && npm run test:oracles"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek",
    "dsh",
    "deepseek-harness",
    "cordis",
    "coding-agent",
    "delegation",
    "local-first",
    "local-llm",
    "lm-studio"
  ],
  "author": "Jim McCormack <mccormackjim3@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jjmlovesgit/dsh-plugin-coding-delegate.git",
    "directory": "plugin"
  },
  "homepage": "https://github.com/jjmlovesgit/dsh-plugin-coding-delegate#readme",
  "bugs": {
    "url": "https://github.com/jjmlovesgit/dsh-plugin-coding-delegate/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-compaction": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@types/node": "^22.13.0",
    "cordis": "^3.18.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
