{
  "name": "dsh-plugin-local-router",
  "version": "0.1.0",
  "description": "DeepSeek Harness Cordis plugin for local-first LLM routing: in-process privacy and complexity classification, local GPU execution, and cloud escalation only when warranted",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "cordis.yml",
    "cordis.patch.yml",
    "cordis.patch.example.yml"
  ],
  "cordis": {
    "name": "dsh-plugin-local-router"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:oracles": "node --test tests/oracles/",
    "test:all": "npm run test && npm run test:oracles"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek",
    "dsh",
    "cordis",
    "local-first",
    "router",
    "rtx5090",
    "lm-studio"
  ],
  "author": "Jim McCormack <mccormackjim3@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.0",
    "cordis": "^3.18.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
