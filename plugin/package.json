{
  "name": "dsh-plugin-coding-delegate",
  "version": "0.5.10",
  "description": "Repo-native cryptographic attestation and anti-self-approval governance for autonomous AI coding agents. A preventive control for DeepSeek Harness: the metered model cannot author code and every delegation leaves a hashable verdict. The architect specifies and is denied write and shell access; a local worker implements inside a bounded workspace; promotion accepts only a SHA-256 match against a machine-checked or operator-attested record, and Schema 1.2 binds the worker and the human reviewer with two Ed25519 signatures kept in the repository's own Git notes.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "cordis.patch.yml",
    "cordis.patch.example.yml"
  ],
  "cordis": {
    "name": "dsh-plugin-coding-delegate"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:oracles": "node --require ./scripts/isolate-oracle-data-dir.cjs --test tests/oracles/*.test.cjs",
    "test:all": "npm run test && npm run test:oracles"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      }
    }
  },
  "keywords": [
    "deepseek",
    "dsh",
    "deepseek-harness",
    "cordis",
    "coding-agent",
    "delegation",
    "local-first",
    "local-llm",
    "lm-studio",
    "ai-governance",
    "attestation",
    "dual-key-signing",
    "non-repudiation",
    "audit-trail",
    "soc2",
    "eu-ai-act",
    "git-notes",
    "ed25519",
    "developer-tools"
  ],
  "author": "Jim McCormack <mccormackjim3@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jjmlovesgit/dsh-plugin-coding-delegate.git",
    "directory": "plugin"
  },
  "homepage": "https://github.com/jjmlovesgit/dsh-plugin-coding-delegate#readme",
  "bugs": {
    "url": "https://github.com/jjmlovesgit/dsh-plugin-coding-delegate/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-compaction": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
